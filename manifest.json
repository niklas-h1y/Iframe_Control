{
  "manifest_version": 3,
  "name": "iFrame Permission Manager",
  "version": "1.0",
  "description": "Easily toggle and control permissions for all iframes on the page.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
