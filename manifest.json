{
  "manifest_version": 3,
  "name": "iFrame Permission Manager",
  "version": "1.1",
  "description": "Control iFrame permissions via runtime content messaging.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
