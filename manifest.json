{
  "manifest_version": 3,
  "name": "iFrame Ultimate Permission Master",
  "version": "2.0",
  "description": "Total control over all 14 HTML5 iframe sandbox permission tokens.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
